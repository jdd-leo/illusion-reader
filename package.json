{
  "name": "illusion-reader",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,tv,ctl -c blue,magenta,yellow \"npm run dev -w @illusion/api\" \"npm run dev -w @illusion/receiver\" \"npm run dev -w @illusion/controller\"",
    "dev:api": "npm run dev -w @illusion/api",
    "dev:receiver": "npm run dev -w @illusion/receiver",
    "dev:controller": "npm run dev -w @illusion/controller",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:mobile": "npm run start -w @illusion/mobile",
    "dev:localtest": "bash scripts/localtest.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
